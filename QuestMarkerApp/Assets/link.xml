<!-- GameObject.CreatePrimitive adds a collider from native code, which the IL2CPP
     stripper cannot see: without this the build logs "class 'SphereCollider' doesn't exist"
     for every marker and panel primitive. -->
<linker>
  <assembly fullname="UnityEngine.PhysicsModule" preserve="all" />
  <!-- High managed stripping. JsonUtility reads these types by reflection, so the
       linker must keep every field. The Meta packages ship their own link.xml. -->
  <assembly fullname="QuestMarkerApp.Runtime" preserve="all" />
</linker>
